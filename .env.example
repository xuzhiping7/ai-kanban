# ============================================================
# AI Kanban — 开发环境配置模板
# 复制为 .env 后修改：  cp .env.example .env
# .env 不会被提交到 Git
# ============================================================

# ---- 本地开发服务器端口 ----
# 端口固定不自动递增，冲突会直接报错
# 修改后需执行：  node scripts/setup-dev-environment.js clear
FRONTEND_PORT=3001
BACKEND_PORT=3002
PREVIEW_PROXY_PORT=3003

# ---- 共享 API 地址（可选）----
# VITE_VK_SHARED_API_BASE=http://localhost:3002
